<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ==========================================================================
       Sillar.Api — host.

       Es el único proyecto que conoce a todos los módulos: los descubre, valida
       el grafo de dependencias y registra únicamente los activos.

       Cuando se añada un módulo nuevo, su ProjectReference va aquí y en ningún
       otro sitio.
       ========================================================================== -->

  <ItemGroup>
    <ProjectReference Include="..\Sillar.Shared\Sillar.Shared.csproj" />
    <ProjectReference Include="..\Sillar.Core.Contracts\Sillar.Core.Contracts.csproj" />
    <ProjectReference Include="..\Sillar.Core\Sillar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Solo diseño: habilita "dotnet ef migrations" y "dotnet ef database".
         PrivateAssets="all" impide que salga en la publicación. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
