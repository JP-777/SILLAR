<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       Sillar.Modules.Sales — M03 Ventas Online.

       Carrito, pedidos y pagos manuales. El contrato público vive en
       Sillar.Modules.Sales.Contracts; dominio y acceso a datos permanecen
       internos al módulo.

       Referencia los Contracts de sus dependencias duras —Catalog y Crm— y
       nunca su Domain ni su Data. Es la regla 3 de módulos, y aquí la vigila
       el compilador: no hay forma de alcanzar una entidad ajena.
       ========================================================================== -->

  <ItemGroup>
    <ProjectReference Include="..\Sillar.Shared\Sillar.Shared.csproj" />
    <ProjectReference Include="..\Sillar.Shared.Data\Sillar.Shared.Data.csproj" />
    <ProjectReference Include="..\Sillar.Core.Contracts\Sillar.Core.Contracts.csproj" />
    <ProjectReference Include="..\Sillar.Modules.Sales.Contracts\Sillar.Modules.Sales.Contracts.csproj" />
    <ProjectReference Include="..\Sillar.Modules.Catalog.Contracts\Sillar.Modules.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\Sillar.Modules.Crm.Contracts\Sillar.Modules.Crm.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sillar.Modules.Sales.Tests" />
  </ItemGroup>

  <!-- Migraciones candidatas NO RATIFICADAS, fuera de la secuencia ejecutable.
       Los archivos se conservan intactos en Migrations/, pero no se compilan: EF no
       las descubre, así que ni el instalador (MigrateAsync) ni `dotnet ef database
       update` pueden aplicarlas junto con las autorizadas. El modelo y el snapshot
       siguen en lo ratificado. Ratificar una es quitar su línea de aquí y llevar el
       modelo y el snapshot a lo que ella describe. -->
  <ItemGroup>
    <Compile Remove="Migrations\20261026235530_SalesPaymentRetentionCandidate20261026.cs" />
    <Compile Remove="Migrations\20261026235530_SalesPaymentRetentionCandidate20261026.Designer.cs" />
    <None Include="Migrations\20261026235530_SalesPaymentRetentionCandidate20261026.cs" />
    <None Include="Migrations\20261026235530_SalesPaymentRetentionCandidate20261026.Designer.cs" />
  </ItemGroup>

</Project>
