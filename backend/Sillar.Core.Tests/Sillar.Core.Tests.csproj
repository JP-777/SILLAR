<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       Pruebas de Sillar.Core.

       Casi todo es lógica: la secuencia de inicio de sesión, la política de
       contraseñas, la vigencia de las sesiones y la jerarquía de roles. Nada
       levanta el host.

       La excepción, y está declarada aquí porque esta cabecera decía «nada aquí
       toca la base de datos» y dejó de ser verdad: ArranqueContraBaseVaciaTests
       crea y destruye una base SIN MIGRAR. Es el único caso que no se puede
       comprobar de otra forma —los proyectos que tocan base están atados a la
       efímera de la puerta, que llega ya migrada— y es justo el que produjo un
       500 en la primera pantalla de una instalación nueva.
       ========================================================================== -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sillar.Core\Sillar.Core.csproj" />
    <!-- Los módulos reales, SOLO para las pruebas del instalador y de la
         activación: el caso que hay que demostrar es «una base vacía queda con
         los schemas de todos los módulos desplegados», y eso no se prueba sin
         desplegarlos. Es composición de pruebas, no una dependencia de CORE:
         Sillar.Core sigue sin referenciar a ningún módulo. -->
    <ProjectReference Include="..\Sillar.Modules.Catalog\Sillar.Modules.Catalog.csproj" />
    <ProjectReference Include="..\Sillar.Modules.Cms\Sillar.Modules.Cms.csproj" />
    <ProjectReference Include="..\Sillar.Modules.Crm\Sillar.Modules.Crm.csproj" />
    <!-- Igual que el host: la DLL de demostración solo existe en Debug. -->
    <ProjectReference Include="..\Sillar.Modules.Demo\Sillar.Modules.Demo.csproj"
                      Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
