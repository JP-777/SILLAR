<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       Pruebas de Sillar.Shared.

       Lo que se prueba aquí es lógica pura: la validación del grafo de módulos,
       que decide si el host arranca o aborta. No hay base de datos ni host, así
       que las pruebas corren en milisegundos y sin entorno.
       ========================================================================== -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Un proyecto de pruebas no documenta su API: no la tiene. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sillar.Shared\Sillar.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
