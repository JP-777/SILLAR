<Project Sdk="Microsoft.NET.Sdk">

  <!-- M10: solo lectura. Sin schema ni migraciones; lee M03 únicamente por Sales.Contracts. -->
  <ItemGroup>
    <ProjectReference Include="..\Sillar.Modules.Sales.Contracts\Sillar.Modules.Sales.Contracts.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Sillar.Shared\Sillar.Shared.csproj" />
    <ProjectReference Include="..\Sillar.Core.Contracts\Sillar.Core.Contracts.csproj" />
  </ItemGroup>

  <!-- Los puertos hacia lectores que M03 todavía no publica son internos: las
       pruebas los sustituyen por dobles sin que M10 publique una firma propia. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Sillar.Modules.Reports.Tests" />
  </ItemGroup>

  <!-- Adaptadores a los lectores monetarios de M03 (candidato 014fba0). Esta rama no
       tiene esos contratos: compilan solo con -p:SalesMonetaryContracts=true sobre un
       árbol que los tenga. Al integrar las ramas, se retira la condición. -->
  <PropertyGroup Condition="'$(SalesMonetaryContracts)' == 'true'">
    <DefineConstants>$(DefineConstants);SALES_MONETARY_CONTRACTS</DefineConstants>
  </PropertyGroup>

</Project>
