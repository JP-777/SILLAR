<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       Sillar.Core — módulo núcleo.

       Dominio, datos, migraciones y endpoints de CORE. Nadie referencia este
       proyecto salvo el host: los demás módulos solo ven Sillar.Core.Contracts.
       ========================================================================== -->

  <ItemGroup>
    <ProjectReference Include="..\Sillar.Shared\Sillar.Shared.csproj" />
    <ProjectReference Include="..\Sillar.Core.Contracts\Sillar.Core.Contracts.csproj" />
    <ProjectReference Include="..\Sillar.Shared.Data\Sillar.Shared.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las piezas internas de CORE se prueban sin volverlas públicas: lo que
         no forma parte del contrato no tiene por qué salir del módulo solo
         para poder comprobarlo. -->
    <InternalsVisibleTo Include="Sillar.Core.Tests" />
  </ItemGroup>

</Project>
