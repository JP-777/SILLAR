# Normaliza finales de línea. Indispensable porque el desarrollo alterna
# entre Windows y Arch Linux: sin esto, los diffs se llenan de ruido y
# los scripts .sh fallan al ejecutarse en Linux.
* text=auto eol=lf

# Archivos que deben conservar finales de línea de Windows
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binarios: nunca tocar
*.png  binary
*.jpg  binary
*.webp binary
*.pdf  binary
*.xlsx binary
*.ico  binary
*.zip  binary
