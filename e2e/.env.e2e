# ============================================================================
# Entorno del arnés e2e. Se COMMITEA a propósito, a diferencia de .env: no hay
# ningún secreto real aquí, solo una contraseña de una base de datos efímera
# que docker-compose.yml destruye al final de cada corrida (down -v). Que
# "correr en cada cambio sin que nadie mire" no dependa de que alguien copie
# un .env.e2e.example primero es parte del punto.
#
# Project name, puertos, base de datos y carpeta de medios distintos de los
# de desarrollo: este stack nunca toca sillar_dev, aunque esté arriba a la
# vez. Ver e2e/README.md.
# ============================================================================

COMPOSE_PROJECT_NAME=sillar_e2e

POSTGRES_USER=postgres
POSTGRES_PASSWORD=e2e_efimera_no_es_secreto
POSTGRES_DB=sillar_e2e
POSTGRES_PORT=55432

# pgadmin nunca se levanta en e2e (no está en ningún --profile que uses este
# archivo), pero docker compose interpola TODO el archivo al validar, sin
# importar qué servicio se pida — así que su variable obligatoria necesita
# igualmente un valor.
PGADMIN_PASSWORD=e2e_no_se_usa

API_PORT=55081
MEDIA_PATH=./e2e/.media-e2e

# Vite no lo levanta docker: playwright.config.ts lo arranca como webServer,
# apuntando su proxy (frontend/vite.config.ts) a la API de este stack.
FRONTEND_PORT=55173

ASPNETCORE_ENVIRONMENT=Development
BUILD_CONFIGURATION=Debug
MODULES_INCLUDE_DEMO=true

ConnectionStrings__Default=Host=localhost;Port=55432;Database=sillar_e2e;Username=postgres;Password=e2e_efimera_no_es_secreto
