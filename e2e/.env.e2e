# ============================================================================
# Entorno del arnés e2e. Se COMMITEA a propósito, a diferencia de .env: no hay
# ningún secreto real aquí, solo una contraseña de una base de datos efímera
# que docker-compose.yml destruye al final de cada corrida (down -v). Que
# "correr en cada cambio sin que nadie mire" no dependa de que alguien copie
# un .env.e2e.example primero es parte del punto.
#
# ----------------------------------------------------------------------------
# LO QUE YA NO ESTÁ AQUÍ, Y POR QUÉ
#
# Este archivo tenía además la identidad de la worktree: COMPOSE_PROJECT_NAME,
# POSTGRES_DB, POSTGRES_PORT, API_PORT, FRONTEND_PORT y la cadena de conexión.
# Ya no. Esos seis valores se DERIVAN del directorio del árbol, en
# scripts/identidad.mjs, y el arnés se los pasa a compose por el entorno del
# proceso, que gana al --env-file en la interpolación.
#
# Que se commiteara con la identidad dentro fue la decisión CORRECTA el día que
# se tomó, y conviene decirlo: entonces había una sola worktree, el archivo no
# guardaba ningún secreto, y versionarlo era lo que hacía que la suite
# arrancara sin ceremonia en cualquier máquina. Lo que caducó no fue el
# criterio: fue el mundo en el que se aplicaba. La segunda worktree convirtió
# un archivo compartido en una identidad compartida, y a partir de ahí cada
# árbol nuevo tenía que acordarse de editar seis líneas —el documento decía
# cuatro— antes de arrancar nada.
#
# Es el §14 de la bitácora otra vez, esta vez sobre una decisión buena: una
# decisión no se juzga por lo que se ve después, sino por lo que se sabía
# entonces. Lo que hay que registrar no es «nos equivocamos», es «cambió el
# supuesto».
#
# Para ver la identidad de este árbol:   node scripts/identidad.mjs
#
# AVISO si lanzas compose a mano contra este archivo: sin esos valores en el
# entorno, docker-compose.yml cae en sus valores por defecto —proyecto
# «sillar», base «sillar_dev», puerto 5432— y eso es el stack de DESARROLLO,
# no el de e2e. No lo hagas a pelo; deja que el arnés lo levante, o exporta
# antes la identidad que imprime el guion de arriba.
# ============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=e2e_efimera_no_es_secreto

# pgadmin nunca se levanta en e2e (no está en ningún --profile que uses este
# archivo), pero docker compose interpola TODO el archivo al validar, sin
# importar qué servicio se pida — así que su variable obligatoria necesita
# igualmente un valor.
PGADMIN_PASSWORD=e2e_no_se_usa

MEDIA_PATH=./e2e/.media-e2e

ASPNETCORE_ENVIRONMENT=Development
BUILD_CONFIGURATION=Debug
MODULES_INCLUDE_DEMO=true
