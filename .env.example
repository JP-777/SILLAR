# ============================================================
# Configuración local del entorno de desarrollo
#
# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / Git Bash:    cp .env.example .env
# ============================================================

# Prefijo de los contenedores. Útil si levantas varias instalaciones.
COMPOSE_PROJECT_NAME=sillar

# --- PostgreSQL ---------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_clave
# Base de datos local de desarrollo. En una instalación real lleva el nombre del negocio.
POSTGRES_DB=sillar_dev
POSTGRES_PORT=5432

# --- pgAdmin (opcional) -------------------------------------
# Se levanta con:  docker compose --profile tools up -d
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=cambiar_esta_clave
PGADMIN_PORT=5050

# --- Backend ------------------------------------------------
# Puerto del API cuando se levanta en contenedor:
#   docker compose --profile full up -d
API_PORT=5080

# Carpeta de los archivos subidos. RESPÁLDALA JUNTO CON LA BASE DE DATOS:
# restaurar solo la base deja el catálogo entero sin imágenes (ADR-011).
MEDIA_PATH=./media
# Cadena de conexión que usará ASP.NET Core.
# Desde el host se conecta a localhost; desde otro contenedor, a "db".
ConnectionStrings__Default=Host=localhost;Port=5432;Database=sillar_dev;Username=postgres;Password=cambiar_esta_clave
