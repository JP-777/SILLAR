# ============================================================
# Configuración local del entorno de desarrollo
#
# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / Git Bash:    cp .env.example .env
# En worktrees paralelos ejecuta dotnet/EF desde su propio árbol: si AppContext.BaseDirectory no lleva a un .env, DotEnv busca hacia arriba desde el directorio de trabajo.
# ============================================================

# Prefijo de los contenedores. Útil si levantas varias instalaciones.
COMPOSE_PROJECT_NAME=sillar

# --- PostgreSQL ---------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_clave
# Base de datos local de desarrollo. En una instalación real lleva el nombre del negocio.
POSTGRES_DB=sillar_dev
POSTGRES_PORT=5432

# --- pgAdmin (opcional) -------------------------------------
# Se levanta con:  docker compose --profile tools up -d
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=cambiar_esta_clave
PGADMIN_PORT=5050

# --- Backend ------------------------------------------------
# Puerto del API cuando se levanta en contenedor:
#   docker compose --profile full up -d
API_PORT=5080

# Carpeta de los archivos subidos. RESPÁLDALA JUNTO CON LA BASE DE DATOS:
# restaurar solo la base deja el catálogo entero sin imágenes (ADR-011).
MEDIA_PATH=./media
# Cadena de conexión que usará ASP.NET Core.
# Desde el host se conecta a localhost; desde otro contenedor, a "db".
ConnectionStrings__Default=Host=localhost;Port=5432;Database=sillar_dev;Username=postgres;Password=cambiar_esta_clave

# Código de este nodo. Identifica la instalación para la replicación
# (ADR-018) y **aparece en el registro de PostgreSQL** como nombre de
# aplicación: «SILLAR API (principal)».
#
# Ponlo distinto en cada árbol de trabajo de la misma máquina. Con el registro
# de conexiones encendido, todas llegan desde la misma IP de pasarela, así que
# esto es lo único que dice **qué proceso** se conectó — y el 21 de agosto de
# 2026 no saberlo costó diez mensajes de investigación.
Sillar__Node__Code=principal

# --- URL pública y reverse proxy -----------------------------
# Origen canónico usado en enlaces de verificación, recuperación e invitación.
# En producción conviene fijarlo aunque también uses ForwardedHeaders.
Sillar__PublicBaseUrl=

# Actívalo solo si la API está detrás de un proxy que controles.
# Añade la IP real del proxy que conecta directamente con Kestrel.
Sillar__Proxy__ForwardedHeadersEnabled=false
Sillar__Proxy__KnownProxies__0=127.0.0.1

# --- Correo saliente ----------------------------------------
# Servidor, puerto y remitente se configuran desde el panel.
# La contraseña es un secreto de despliegue: nunca va en la base de datos.
SILLAR_SMTP_PASSWORD=
